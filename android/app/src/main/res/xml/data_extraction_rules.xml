<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Keeps Google sign-in tokens out of backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="just_capture_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="just_capture_auth.xml" />
    </device-transfer>
</data-extraction-rules>
